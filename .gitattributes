# Scripts run under bash and python on macOS, Linux and Windows (Git Bash): keep them LF everywhere,
# or Git for Windows' autocrlf turns them into CRLF and bash fails on the first line.
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.conf text eol=lf

# Orchestration layer: versioned here, but kept out of the Packagist dist archive.
/AGENTS.md        export-ignore
/CLAUDE.md        export-ignore
/.orchestrator    export-ignore
/.agents          export-ignore
/.claude          export-ignore
/memory           export-ignore
/.gitattributes   export-ignore
